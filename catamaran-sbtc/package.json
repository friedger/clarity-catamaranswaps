{
  "name": "catamaran-btc-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "rv:test": "rv . btc-sbtc-swap test",
    "rv:invariant": "rv . btc-sbtc-swap invariant",
    "generate:types": "clarigen"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clarigen/cli": "^2.1.2",
    "@clarigen/core": "^2.1.2",
    "@clarigen/test": "^2.1.2",
    "@hirosystems/clarinet-sdk": "2.13.0-beta17",
    "@noble/hashes": "^1.7.1",
    "@stacks/rendezvous": "^0.4.0",
    "@stacks/transactions": "^7.0.4",
    "chokidar-cli": "^3.0.0",
    "typescript": "^5.3.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vitest-environment-clarinet": "^2.1.0"
  },
  "engines": {
    "node": "22.13"
  }
}
